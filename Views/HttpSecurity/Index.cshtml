@{
    ViewData["Title"] = "Secure HTTP Security";
}

<div class="container mt-5">

    <h1>Secure HTTP Security</h1>

    <p>
        This page demonstrates secure HTTP response headers.
    </p>

    <div class="alert alert-success">
        Security headers are enabled to improve the protection of the application.
    </div>

    <h3>Enabled Security Headers</h3>

    <ul>
        <li>X-Content-Type-Options: nosniff</li>
        <li>X-Frame-Options: DENY</li>
        <li>Referrer-Policy: strict-origin-when-cross-origin</li>
        <li>Permissions-Policy</li>
        <li>Content-Security-Policy</li>
    </ul>

    <p>
        Sensitive debugging and environment headers are not exposed.
    </p>

</div>