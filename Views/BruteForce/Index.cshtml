@{
    ViewData["Title"] = "Secure Brute Force Protection";
}

<div class="container mt-5">

    <div class="text-center mb-5">

        <h1>Secure Brute Force Protection</h1>

        <p class="text-muted">
            CyberTrace Secure Brute Force Security Lab
        </p>

    </div>

    <div class="alert alert-success shadow">

        <h5>Brute Force Protection</h5>

        <p class="mb-0">
            This version limits failed login attempts and temporarily
            blocks authentication after multiple failed attempts.
        </p>

    </div>

    <div class="card border-success shadow mx-auto"
         style="max-width: 700px;">

        <div class="card-header bg-success text-white">

            <h4 class="mb-0">
                🟢 Secure Login
            </h4>

        </div>

        <div class="card-body">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }

            @if (ViewBag.Success != null)
            {
                <div class="alert alert-success">
                    @ViewBag.Success
                </div>
            }

            <form asp-controller="BruteForce"
                  asp-action="Index"
                  method="post">

                <div class="mb-3">

                    <label class="form-label">
                        Username
                    </label>

                    <input type="text"
                           name="username"
                           class="form-control"
                           value="admin"
                           required />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Password
                    </label>

                    <input type="text"
                           name="password"
                           class="form-control"
                           value="wrongpassword"
                           required />

                </div>

                <button type="submit"
                        class="btn btn-success">

                    Test Secure Login

                </button>

            </form>

        </div>

    </div>

    <div class="card shadow mt-4">

        <div class="card-header bg-dark text-white">

            <h4 class="mb-0">
                Brute Force Protection Test
            </h4>

        </div>

        <div class="card-body">

            <h5>Test Instructions</h5>

            <p>
                Enter an incorrect password three times.
            </p>

            <p>
                After the third failed attempt, the application
                should temporarily block further login attempts.
            </p>

            <hr />

            <h5>Valid Credentials</h5>

            <p class="mb-0">

                <code>
                    Username: admin
                </code>

                <br />

                <code>
                    Password: admin123
                </code>

            </p>

        </div>

    </div>

</div>