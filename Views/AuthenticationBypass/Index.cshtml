@{
    ViewData["Title"] = "Secure Authentication";
}

<div class="container mt-5">

    <div class="text-center mb-5">

        <h1>Secure Authentication</h1>

        <p class="text-muted">
            CyberTrace Secure Authentication Lab
        </p>

    </div>

    <div class="alert alert-success shadow">

        <h5>Secure Authentication</h5>

        <p class="mb-0">
            This version verifies the username and password on the server.
            Client-controlled role values are ignored.
            Administrative access is granted only after successful authentication.
        </p>

    </div>

    <div class="card border-success shadow mx-auto"
         style="max-width: 700px;">

        <div class="card-header bg-success text-white">

            <h4 class="mb-0">
                🟢 Secure Login
            </h4>

        </div>

        <div class="card-body">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }

            @if (ViewBag.Success != null)
            {
                <div class="alert alert-success">
                    @ViewBag.Success
                </div>
            }

            @if (ViewBag.Role != null)
            {
                <div class="alert alert-info">
                    <strong>Role:</strong> @ViewBag.Role
                </div>
            }

            <form asp-controller="AuthenticationBypass"
                  asp-action="Index"
                  method="post">

                <div class="mb-3">

                    <label class="form-label">
                        Username
                    </label>

                    <input type="text"
                           name="username"
                           class="form-control"
                           value="attacker"
                           required />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Password
                    </label>

                    <input type="text"
                           name="password"
                           class="form-control"
                           value="wrongpassword"
                           required />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Role
                    </label>

                    <select name="role"
                            class="form-select">

                        <option value="User">
                            User
                        </option>

                        <option value="Admin">
                            Admin
                        </option>

                    </select>

                </div>

                <button type="submit"
                        class="btn btn-success">

                    Test Secure Login

                </button>

            </form>

        </div>

    </div>

    <div class="card shadow mt-4">

        <div class="card-header bg-dark text-white">

            <h4 class="mb-0">
                Secure Authentication Test
            </h4>

        </div>

        <div class="card-body">

            <h5>Invalid Credentials Test</h5>

            <p>
                Use:
            </p>

            <div class="mb-3">

                <code>
                    Username: attacker
                </code>

                <br />

                <code>
                    Password: wrongpassword
                </code>

                <br />

                <code>
                    Role: Admin
                </code>

            </div>

            <p>
                The secure application should reject the login.
            </p>

            <hr />

            <h5>Valid Credentials</h5>

            <p class="mb-0">

                <code>
                    Username: admin
                </code>

                <br />

                <code>
                    Password: admin123
                </code>

            </p>

        </div>

    </div>

</div>